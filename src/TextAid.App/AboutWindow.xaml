<Window x:Class="TextAid.App.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource AboutLabel}" Width="460" Height="390" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/TextAid;component/Assets/TextAid.ico" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24"><StackPanel HorizontalAlignment="Center">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Width="380" Height="180"><Image Source="pack://application:,,,/TextAid;component/Assets/Logo-final.png" Stretch="Uniform"/></Border>
    <TextBlock Text="{DynamicResource ProductName}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    <TextBlock Text="{DynamicResource Subtitle}" Foreground="{DynamicResource ForegroundMutedBrush}" HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
    <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0"><Hyperlink NavigateUri="https://www.e-naxos.com/textaid" RequestNavigate="OnNavigate" Foreground="{DynamicResource AccentBrush}">https://www.e-naxos.com/textaid</Hyperlink></TextBlock>
  </StackPanel></Border>
</Window>
