  <sys:String x:Key="CloseLabel">Close</sys:String><sys:String x:Key="OpenSettingsLabel">Open Settings</sys:String>
  <sys:String x:Key="ProviderSetupTitle">Set up an AI provider</sys:String>
  <sys:String x:Key="ProviderSetupMessage">TextAid could not find a usable local Ollama setup. Install Ollama and download a model, or configure an On-premises Ollama server on your network, or configure an External OpenAI-compatible service with its API key. Provider access is always an explicit choice; Settings remains available while no provider is ready.</sys:String>
  <sys:String x:Key="ClipboardError">Unable to access the clipboard.</sys:String>
