<Window x:Class="TextAid.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource SettingsLabel}" Width="600" Height="690" MinWidth="540" MinHeight="600" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/TextAid;component/Assets/TextAid.ico" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <Style x:Key="DarkTabItem" TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="16,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="DarkTabControl" TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True"/></Border><Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter ContentSource="SelectedContent" Margin="0"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="StatusMarker" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ConnectionState}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding ConnectionState}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding ConnectionState}" Value="Testing"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{DynamicResource SettingsLabel}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Configure each AI connection independently." Margin="0,6,0,0" Foreground="{DynamicResource ForegroundMutedBrush}"/></StackPanel>
    <TabControl Grid.Row="1" Style="{StaticResource DarkTabControl}" Margin="0,22,0,12">
      <TabItem Header="This device only" Style="{StaticResource DarkTabItem}"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20"><StackPanel>
        <CheckBox Content="Active" IsChecked="{Binding LocalEnabled}" Margin="0,0,0,12"/><TextBlock Text="Ollama endpoint" FontWeight="SemiBold"/><TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" ToolTip="This device only accepts localhost, 127.0.0.1, or ::1."/>
        <StackPanel Orientation="Horizontal"><Button Content="Test connection" Command="{Binding TestConnectionCommand}" MinWidth="132" Margin="0,0,8,0"/><Button Content="Load local models" Command="{Binding LoadModelsCommand}" MinWidth="140"/></StackPanel><ProgressBar Height="4" Margin="0,10,0,4" IsIndeterminate="True" Visibility="{Binding IsLoadingModels, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="●" Style="{StaticResource StatusMarker}" FontSize="16" Margin="0,-1,7,0"/><TextBlock Text="Connection status" Style="{StaticResource StatusMarker}" FontWeight="SemiBold"/><TextBlock Text=": "/><TextBlock Text="{Binding ConnectionState}"/></StackPanel><TextBlock Text="Model" FontWeight="SemiBold" Margin="0,16,0,0"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Margin="0,6,0,12" MinHeight="36"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Temperature" FontWeight="SemiBold"/><TextBox Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Context size (tokens)" FontWeight="SemiBold"/><TextBox Text="{Binding ContextSizeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel></Grid>
        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Timeout (seconds)" FontWeight="SemiBold"/><TextBox Text="{Binding TimeoutSecondsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Thinking" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding ThinkingModes}" SelectedItem="{Binding SelectedThinking}" Margin="0,6,0,0" MinHeight="36"/></StackPanel></Grid>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="On-premises" Style="{StaticResource DarkTabItem}"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20"><StackPanel>
        <TextBlock Text="Ollama on an administered network" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="TextAid cannot verify the ownership, routing, or handling of this endpoint." Margin="0,4,0,14" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}"/><CheckBox Content="Active" IsChecked="{Binding NetworkEnabled}" Margin="0,0,0,12"/>
        <TextBlock Text="Endpoint" FontWeight="SemiBold"/><TextBox Text="{Binding NetworkEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/><TextBlock Text="Model" FontWeight="SemiBold"/><TextBox Text="{Binding NetworkModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/><TextBlock Text="API key (optional; leave blank to retain the saved key)" FontWeight="SemiBold"/><PasswordBox Margin="0,6,0,0" PasswordChanged="OnNetworkSecretChanged"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="External" Style="{StaticResource DarkTabItem}"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20"><StackPanel>
        <TextBlock Text="OpenAI-compatible service" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="External service use is a deliberate configuration choice." Margin="0,4,0,14" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}"/><CheckBox Content="Active" IsChecked="{Binding ExternalEnabled}" Margin="0,0,0,12"/>
        <TextBlock Text="Endpoint" FontWeight="SemiBold"/><TextBox Text="{Binding ExternalEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/><TextBlock Text="Model" FontWeight="SemiBold"/><TextBox Text="{Binding ExternalModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/><TextBlock Text="API key (leave blank to retain the saved key)" FontWeight="SemiBold"/><PasswordBox Margin="0,6,0,0" PasswordChanged="OnExternalSecretChanged"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,14,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" Click="OnCancel" MinWidth="96" Margin="0,0,8,0"/><Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96"/></StackPanel></Grid>
  </Grid></Border>
</Window>
