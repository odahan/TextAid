<Window x:Class="TextAid.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource SettingsLabel}" Width="460" Height="260" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/TextAid;component/Assets/TextAid.ico" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24"><StackPanel><TextBlock Text="{DynamicResource SettingsLabel}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource SettingsMessage}" Margin="0,20,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundMutedBrush}"/></StackPanel></Border>
</Window>
