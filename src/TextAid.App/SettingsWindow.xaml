<Window x:Class="TextAid.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource SettingsLabel}" Width="560" Height="650" MinWidth="500" MinHeight="560" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/TextAid;component/Assets/TextAid.ico" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <Style x:Key="DarkComboBox" TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><Grid><ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/><Path HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource ForegroundMutedBrush}" Data="M 0 0 L 8 0 L 4 5 Z"/></Grid></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide"><Border Margin="0,4,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, ElementName=Toggle}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Toggle" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="StatusMarker" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ConnectionState}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding ConnectionState}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding ConnectionState}" Value="Testing"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="{DynamicResource SettingsLabel}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Local Ollama connection and generation controls" Margin="0,6,0,0" Foreground="{DynamicResource ForegroundMutedBrush}"/></StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,12"><StackPanel>
        <TextBlock Text="Ollama endpoint" FontWeight="SemiBold"/><TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" ToolTip="This device only accepts localhost, 127.0.0.1, or ::1."/>
        <StackPanel Orientation="Horizontal"><Button Content="Test connection" Command="{Binding TestConnectionCommand}" MinWidth="132" Margin="0,0,8,0"/><Button Content="Load local models" Command="{Binding LoadModelsCommand}" MinWidth="140"/></StackPanel>
        <ProgressBar Height="4" Margin="0,10,0,4" IsIndeterminate="True" Visibility="{Binding IsLoadingModels, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="●" Style="{StaticResource StatusMarker}" FontSize="16" Margin="0,-1,7,0"/><TextBlock Text="Connection status" Style="{StaticResource StatusMarker}" FontWeight="SemiBold"/><TextBlock Text=": "/><TextBlock Text="{Binding ConnectionState}" Foreground="{DynamicResource ForegroundBrush}"/></StackPanel>
        <TextBlock Text="Model" FontWeight="SemiBold" Margin="0,12,0,0"/><ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Margin="0,6,0,12" MinHeight="36"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Temperature" FontWeight="SemiBold"/><TextBox Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" ToolTip="0 is most deterministic; 2 is most varied."/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Context size (tokens)" FontWeight="SemiBold"/><TextBox Text="{Binding ContextSizeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" ToolTip="Higher values use more memory."/></StackPanel></Grid>
        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Timeout (seconds)" FontWeight="SemiBold"/><TextBox Text="{Binding TimeoutSecondsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Thinking" FontWeight="SemiBold"/><ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding ThinkingModes}" SelectedItem="{Binding SelectedThinking}" Margin="0,6,0,0" MinHeight="36" ToolTip="Off is the default. Higher levels require a model that supports thinking."/></StackPanel></Grid>
        <TextBlock Text="{Binding Status}" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundBrush}"/>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="OnCancel" MinWidth="96" Margin="0,0,8,0"/><Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96"/></StackPanel>
    </Grid>
  </Border>
</Window>
