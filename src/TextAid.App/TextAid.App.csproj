<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TextAid</AssemblyName>
    <Version>0.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)\bin\Publish\</PublishDir>
    <ApplicationIcon>../../assets/TextAid.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TextAid.Core/TextAid.Core.csproj" />
    <ProjectReference Include="../TextAid.Platform.Windows/TextAid.Platform.Windows.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Resource Include="../../assets/Logo-final.png" LogicalName="Assets/Logo-final.png" />
    <Resource Include="../../assets/TextAid.ico" LogicalName="Assets/TextAid.ico" />
  </ItemGroup>
</Project>
