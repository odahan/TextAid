<Window x:Class="TextAid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProductName}" Height="520" Width="680" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual" Icon="pack://application:,,,/TextAid;component/Assets/TextAid.ico" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="72"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource ProductName}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="2" Text="{DynamicResource CapturedText}" FontSize="16" FontWeight="SemiBold"/>
        <TextBox Grid.Row="3" Margin="0,8,0,0" Text="{Binding InputText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Grid.Row="5" Text="{DynamicResource PreviewLabel}" FontSize="16" FontWeight="SemiBold"/>
        <Border Grid.Row="6" Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource ForegroundMutedBrush}" TextWrapping="Wrap"/></Border>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Content="{DynamicResource CancelLabel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource AcceptLabel}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanAccept}" MinWidth="96"/>
        </StackPanel>
      </Grid>
    </Border>
</Window>
