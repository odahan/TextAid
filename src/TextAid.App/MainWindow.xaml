<Window x:Class="TextAid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProductName}" Height="620" Width="980" MinHeight="440" MinWidth="720" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="Manual" Icon="pack://application:,,,/TextAid;component/Assets/TextAid.ico" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource ProductName}" FontSize="20" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <TextBlock Text="{DynamicResource ActionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
          <ComboBox Width="220" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource CapturedText}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource PreviewLabel}" FontSize="16" FontWeight="SemiBold"/>
          <TextBox x:Name="InputEditor" Grid.Row="2" Grid.Column="0" Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
          <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding OutputText}" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" FontSize="14" LineHeight="20"/></ScrollViewer>
          </Border>
        </Grid>
        <StackPanel Grid.Row="5" Margin="0,14,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsTransforming, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Width="180" Height="5" Margin="0,7,10,0" IsIndeterminate="True"/>
            <TextBlock Text="{DynamicResource TransformingLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock MinHeight="22" Text="{Binding Status}" Foreground="{DynamicResource ForegroundMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Content="{DynamicResource NewLabel}" Command="{Binding NewCommand}" MinWidth="82" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource InstructionsLabel}" Command="{Binding InstructionsCommand}" MinWidth="106" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource ProcessLabel}" Command="{Binding ProcessCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource CancelLabel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource CopyLabel}" Command="{Binding CopyCommand}" MinWidth="96" Margin="0,0,8,0"/>
          <Button Content="{DynamicResource ReplaceLabel}" Command="{Binding ReplaceCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
        </StackPanel>
      </Grid>
    </Border>
</Window>
