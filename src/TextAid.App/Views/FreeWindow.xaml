<Window x:Class="TextAid.App.Views.FreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FreeLabel}" Width="520" Height="310" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="FreeEditor" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{DynamicResource CancelLabel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource ProceedLabel}" IsDefault="True" Click="Proceed_Click" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
