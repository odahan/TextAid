<Window x:Class="TextAid.App.Views.StartupNoticeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource ProviderSetupTitle}" Width="540" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/TextAid;component/Assets/TextAid.ico" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="●" Foreground="{DynamicResource WarningBrush}" FontSize="22" Margin="0,-4,10,0"/>
                <TextBlock Text="{DynamicResource ProviderSetupTitle}" FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{DynamicResource ProviderSetupMessage}" TextWrapping="Wrap" Margin="0,20,0,16" Foreground="{DynamicResource ForegroundBrush}"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource CloseLabel}" Click="OnClose" MinWidth="96" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource OpenSettingsLabel}" Click="OnOpenSettings" Style="{StaticResource PrimaryButton}" MinWidth="126"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
