<Window x:Class="TextAid.App.Views.TranslationReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource TranslationReviewTitle}" Width="1040" Height="680" MinWidth="820" MinHeight="520" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource TranslationReviewTitle}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource TranslationReviewHelp}" Foreground="{DynamicResource ForegroundMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <DataGrid x:Name="TranslationGrid" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionChanged="OnTranslationSelectionChanged" AutoGenerateColumns="False" IsReadOnly="False" Margin="0,18,0,12" CanUserAddRows="False" SelectionMode="Single" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource StableKeyLabel}" Binding="{Binding Key}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="{DynamicResource EnglishSourceLabel}" Binding="{Binding English}" IsReadOnly="True" Width="3*"/>
                    <DataGridTextColumn Header="{DynamicResource SuggestedTranslationLabel}" Binding="{Binding Suggested}" IsReadOnly="True" Width="3*"/>
                    <DataGridTextColumn Header="{DynamicResource PersonalOverrideLabel}" Binding="{Binding PersonalOverride, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
                    <DataGridTextColumn Header="{DynamicResource TranslationOriginLabel}" Binding="{Binding Origin}" IsReadOnly="True" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{DynamicResource ImportLanguagePackLabel}" Click="OnImport" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource ExportLanguagePackLabel}" Click="OnExport" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource DeleteLanguageCacheLabel}" Command="{Binding DeleteLanguageCacheCommand}"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="" VerticalAlignment="Center" Margin="20,0,4,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" d:Text="Champ de recherche" Foreground="{DynamicResource ForegroundMutedBrush}" MinWidth="110" Margin="0,0,4,0"/>
                        <Button Width="30" Command="{Binding FindNextCommand}" FontFamily="Segoe UI Symbol" Content="&#x25BC;" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="{DynamicResource RestoreSuggestedLabel}" Command="{Binding RestoreSuggestedCommand}" Margin="0,0,8,0" Width="130"/>
                    <Button Content="{DynamicResource SaveCorrectionLabel}" Command="{Binding SaveCorrectionCommand}" Style="{StaticResource PrimaryButton}" Width="130"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
